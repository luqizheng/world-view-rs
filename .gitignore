# Rust
/target
**/*.rs.bk

# 编辑器 / IDE
.vscode/
.idea/
*.swp

# 工程快照目录（由应用生成，不进版本管理）
/snapshots/
examples/*/snapshots/

# WorkBuddy 工具态（项目记忆、UI 校验产物等）—— 不纳入版本控制
.workbuddy/

# 隔离工作区（本地 git worktree 落点，commit 临时工作）
.worktrees/

# 构建 / 验证日志（本地跑 cargo 留的尾迹，不进版本管理）
*.log

# 操作系统
.DS_Store
Thumbs.db
desktop.ini
