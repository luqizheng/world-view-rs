<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- Pin the whole xunit v3 stack to 3.2.2 to exactly match the version
         Avalonia.Headless.XUnit 12.1.6 depends on - mixing v2 or another v3 series
         causes CS0433 duplicate-attribute errors (FactAttribute in two frameworks). -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WorldView.PresentationPrototype\WorldView.PresentationPrototype.csproj" />
  </ItemGroup>

</Project>
