<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ToolbarTextRepro.MainWindow"
        Title="Toolbar text repro - 6 buttons + glyph-run probe"
        Width="900" Height="340">
  <!-- MINIMAL REPRODUCIBLE CASE (TV-01 known issue #1):
       Horizontal StackPanel with N short-text buttons under SimpleTheme + UseHarfBuzz.
       Row 1 hosts a minimal custom Control that optionally draws a hand-built GlyphRun
       (mode: manual, textlayout, off, construct) to compare consumption paths. -->
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16">
      <Button x:Name="Load1KButton"  Width="104" Margin="0,0,6,0" />
      <Button x:Name="Load10KButton" Width="104" Margin="0,0,6,0" />
      <Button Content="Load 50K" Width="104" Margin="0,0,6,0" />
      <Button Content="Rebuild (new version)" Width="170" Margin="0,0,6,0" />
      <Button Content="Zoom +"   Width="84"  Margin="0,0,6,0" />
      <Button Content="Reset view" Width="104" />
    </StackPanel>
    <Panel Grid.Row="1" x:Name="ProbeHost" Background="#FFF8F0" />
  </Grid>
</Window>
