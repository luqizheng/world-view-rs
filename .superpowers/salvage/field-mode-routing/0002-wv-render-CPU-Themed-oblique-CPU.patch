+// ══════ ADR-0082 Task 2：场管线的模式路由（`should_render_field` 真值表）══════
+
+#[cfg(test)]
+mod field_routing_tests {
+    use super::*;
+    use crate::state::ViewMode;
+    use wv_core::terrain::TerrainData;
+
+    /// 构造只差三个路由字段的 `ViewState`（其余全默认：`field_render` 意愿、
+    /// `mode`、`topographic_compression`——三者的组合即路由真值表的全集）。
+    fn view_at(mode: ViewMode, field_render: bool, compression: f32) -> ViewState {
+        ViewState {
+            mode,
+            field_render,
+            topographic_compression: compression,
+            ..ViewState::default()
+        }
+    }
+
+    /// 真值表行（ADR-0082 D2）：场支持档 + 意愿开 + 默认 compression 0.3。
+    ///
+    /// Topographic 在 oblique（compression > 0）下必须回落 CPU——平放的场
+    /// quad 吃不到 2.5D 顶点斜切（活缺陷②）；其余三支持档照常上 GPU 场。
+    #[test]
+    fn field_supported_modes_route_to_field() {
+        assert!(
+            !should_render_field(&view_at(ViewMode::Topographic, true, 0.3)),
+            "Topographic + compression 0.3：oblique 生效，场 quad 会吃掉斜切 → CPU"
+        );
+        for mode in [
+            ViewMode::VectorFlat,
+            ViewMode::RealTerrain,
+            ViewMode::GoogleMap,
+        ] {
+            assert!(
+                should_render_field(&view_at(mode, true, 0.3)),
+                "{mode:?} 属场支持档且无 oblique → GPU 场"
+            );
+        }
+    }
+
+    /// CPU 留守档（Faction / Event / Coastline）任何 compression 都不上场。
+    ///
+    /// 活缺陷①的回归守点：转正后没有模式路由，切这三档曾错画成 Themed 场
+    /// （三档的地表语义——势力填色 / 事件高亮 / 黑底轮廓——只有 CPU 烘焙
+    /// 管线实现了对应 ShadeMode）。
+    #[test]
+    fn cpu_reserved_modes_never_route_to_field() {
+        for mode in [ViewMode::Faction, ViewMode::Event, ViewMode::Coastline] {
+            for compression in [0.0, 0.3] {
+                assert!(
+                    !should_render_field(&view_at(mode, true, compression)),
+                    "{mode:?} + compression {compression}：CPU 留守档不得路由到场 quad"
+                );
+            }
+        }
+    }
+
+    /// oblique 判据必须与 mode 合取（ADR-0082 D2）：`topographic_compression`
+    /// 是**全局字段**（默认 0.3，与 mode 无关），非 Topographic 档带着 0.3 也
+    /// 必须照常上场；Topographic 把 compression 归零（纯 2D，无斜切）则留在
+    /// GPU 场。
+    #[test]
+    fn oblique_only_pulls_topographic_back_to_cpu() {
+        assert!(
+            should_render_field(&view_at(ViewMode::VectorFlat, true, 0.3)),
+            "VectorFlat + compression 0.3：判据与 mode 合取，不得被全局 compression 误拖回 CPU"
+        );
+        assert!(
+            should_render_field(&view_at(ViewMode::Topographic, true, 0.0)),
+            "Topographic + compression 0.0：纯 2D 无斜切，场 quad 照常上屏"
+        );
+    }
+
+    /// 意愿开关（`ToggleFieldRender` 命令写的那一位，ADR-0053 的回退开关）
+    /// 压过一切路由：关即全表 false——路由只能在其之上**进一步**收回，
+    /// 不能替用户打开。
+    #[test]
+    fn field_render_wish_gates_everything() {
+        for mode in ViewMode::ALL {
+            for compression in [0.0, 0.3] {
+                assert!(
+                    !should_render_field(&view_at(mode, false, compression)),
+                    "{mode:?} + compression {compression}：field_render=false 必须全场 false"
+                );
+            }
+        }
+    }
+
+    // ── 系统级互斥（ADR-0082 D2 验收行）：路由翻转后两条底图路径只活一条 ──
+
