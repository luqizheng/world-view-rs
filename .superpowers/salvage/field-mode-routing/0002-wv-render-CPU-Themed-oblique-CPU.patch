+// ══════ ADR-0082 Task 2：场管线的模式路由（底图载体选择的唯一判据）══════
+
+/// 本模式是否属于场管线（GPU 逐像素求值）的支持档（ADR-0082 D2）。
+///
+/// 支持集 = { VectorFlat, GoogleMap, RealTerrain, Topographic }；
+/// **CPU 留守档** = { Faction, Event, Coastline }——三档的地表语义（势力
+/// 填色 / 事件高亮 / 黑底水陆轮廓）只有 CPU 烘焙管线实现了对应 `ShadeMode`
+/// 分支，GPU 场 quad 在这些模式下只会错画成 Themed 场（ADR-0082 §1 缺陷①）。
+///
+/// 独立 pub：真值表测试与将来的调试面板复用同一份词表，**禁止**消费点
+/// 各写 `matches!`（判据漂移 = 双底图红线的开口）。
+pub fn supports_field(mode: crate::state::ViewMode) -> bool {
+    matches!(
+        mode,
+        crate::state::ViewMode::VectorFlat
+            | crate::state::ViewMode::GoogleMap
+            | crate::state::ViewMode::RealTerrain
+            | crate::state::ViewMode::Topographic
+    )
+}
+
+/// 2.5D oblique 是否生效（ADR-0041 的顶点 Z 挤压）：仅 Topographic 且
+/// compression > 0 时成立。
+///
+/// `topographic_compression` 是**全局字段**（默认 0.3，与 mode 无关）——
+/// 判据若不与 `mode == Topographic` 合取，非 Topographic 档会被全局默认值
+/// 误拖回 CPU（ADR-0082 §1 缺陷②的对偶坑）。oblique 生效时，平放的场
+/// quad 吃不到顶点斜切（oblique 只在 CPU 侧的 chunk mesh 顶点 Z 上存在），
+/// 底图必须整层回落 CPU 路径。
+fn oblique_active(view: &ViewState) -> bool {
+    view.mode == crate::state::ViewMode::Topographic && view.topographic_compression > 0.0
+}
+
+/// 本帧场 quad 是否该上屏（ADR-0082 D2：模式路由的**唯一判据**）。
+///
+/// 三层合取：
+/// 1. **意愿开关** `view.field_render`（`ToggleFieldRender` 命令写的那一位，
+///    ADR-0053 回退开关）——路由只能在其之上**进一步**收回，不能替用户打开；
+/// 2. **模式支持档** [`supports_field`]——CPU 留守档不上场；
+/// 3. **非 oblique** [`oblique_active`]——Topographic + compression > 0 回落
+///    CPU（平放 quad 吃掉斜切）。
+///
+/// **双底图红线**：[`sync_terrain_chunks`] 的整层早退与 [`sync_terrain_field`]
+/// 的 gate **必须消费同一个函数**——两处各写布尔式，加档位时迟早漂移成
+/// 「两条底图同帧上屏」（ADR-0053 以来的红线，本函数是其客观兜底）。
+pub fn should_render_field(view: &ViewState) -> bool {
+    view.field_render && supports_field(view.mode) && !oblique_active(view)
+}
