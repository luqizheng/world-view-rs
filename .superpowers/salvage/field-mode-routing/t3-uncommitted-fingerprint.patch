+    /// 0×0 / 1×1 / 全水 5×5：不 panic，`total()` 与全量重建一致；越界矩形
+    /// 在退化幅面上也只是钳制后无事。
+    #[test]
+    fn fingerprint_handles_degenerate_grids() {
+        // 0×0：无块，total = 纯 offset 基值；越界矩形不动任何东西。
+        let empty = TerrainData {
